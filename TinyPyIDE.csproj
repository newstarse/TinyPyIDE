<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
	<UseWindowsForms>true</UseWindowsForms>
	<PlatformTarget>x64</PlatformTarget>
	<PackageIcon>IDE.png</PackageIcon>
	<ApplicationIcon>Properties\Resources\IDE.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="CustomMessageBox.cs" />
    <Compile Remove="EmbeddedTerminal.cs" />
    <Compile Remove="IPythonSession.cs" />
    <Compile Remove="TerminalManager.cs" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Remove="EmbeddedTerminal.resx" />
  </ItemGroup>

  <ItemGroup>
    <None Remove="源代码保存-202607222302.txt" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Properties\Resources\IDE.ico" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Configuration" Version="9.0.5" />
    <PackageReference Include="Microsoft.Extensions.Configuration.FileExtensions" Version="9.0.5" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Ini" Version="9.0.5" />
    <PackageReference Include="Scintilla5.NET" Version="6.1.2" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="ConEmu.WinForms">
      <HintPath>bin\Debug\net10.0-windows\ConEmu.WinForms.dll</HintPath>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <Compile Update="Properties\Resources.Designer.cs">
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
      <DependentUpon>Resources.resx</DependentUpon>
    </Compile>
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Update="Properties\Resources.resx">
      <Generator>ResXFileCodeGenerator</Generator>
      <LastGenOutput>Resources.Designer.cs</LastGenOutput>
    </EmbeddedResource>
  </ItemGroup>

  <ItemGroup>
    <None Update="Properties\Resources\IDE.png">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
  </ItemGroup>

</Project>